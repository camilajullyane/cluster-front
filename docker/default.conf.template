# Gerado em /etc/nginx/conf.d/default.conf na subida do container.
# LAMBDA_HOST: host da Function URL, ex.: abc123.lambda-url.us-east-1.on.aws

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # DNS do Docker. Usar variável no proxy_pass faz o nginx resolver o host
    # periodicamente, já que os IPs da Function URL mudam com o tempo.
    resolver ${NGINX_RESOLVER} valid=60s ipv6=off;
    set $lambda_upstream https://${LAMBDA_HOST};

    location /api/ {
        proxy_pass $lambda_upstream;
        # A Function URL roteia pelo Host/SNI: precisam ser o host da Lambda.
        proxy_set_header Host ${LAMBDA_HOST};
        proxy_ssl_server_name on;
        proxy_ssl_name ${LAMBDA_HOST};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 30s;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
