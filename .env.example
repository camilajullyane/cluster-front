# --- Docker / EC2 ---
# Host da Lambda Function URL (sem https:// e sem barra final)
LAMBDA_HOST=abc123.lambda-url.us-east-1.on.aws
# Porta exposta no EC2
HTTP_PORT=80

# --- Desenvolvimento local (npm run dev) ---
# Para onde o Vite repassa /api. Padrão: Lambda local (cluster-lambda: npm run local).
# Para usar a Lambda real: API_PROXY_TARGET=https://<id>.lambda-url.us-east-1.on.aws
API_PROXY_TARGET=

# Build: deixe vazio para usar /api via proxy do nginx (recomendado).
# Preencha só se o front for chamar a Lambda direto (exige ALLOWED_ORIGIN na Lambda).
VITE_API_URL=
